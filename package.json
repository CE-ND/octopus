{
  "name": "octopus-desktop",
  "version": "0.1.10",
  "private": true,
  "description": "Desktop wrapper for Octopus",
  "main": "desktop/main.js",
  "scripts": {
    "dev": "node scripts/dev-desktop.cjs",
    "desktop:test": "node --test scripts/tests/*.test.cjs",
    "desktop:test:bridge": "node scripts/test-desktop-update-bridge.cjs",
    "desktop:prepare": "node scripts/desktop-prepare.js",
    "desktop:dev": "node scripts/dev-desktop.cjs",
    "desktop:pack": "pnpm desktop:prepare && electron-builder --dir",
    "desktop:dist": "pnpm desktop:prepare && electron-builder",
    "desktop:dist:custom": "node scripts/desktop-custom-installer.js",
    "installer:preview": "node scripts/build-native-installer.cjs --preview",
    "installer:toolchain": "node scripts/installer-toolchain.cjs",
    "installer:test": "node scripts/test-native-installer.cjs"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.hureru.octopus.desktop",
    "productName": "Octopus",
    "asar": true,
    "publish": {
      "provider": "github",
      "owner": "CE-ND",
      "repo": "octopus",
      "releaseType": "release"
    },
    "directories": {
      "output": "dist/desktop"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/desktop/backend",
        "to": "backend",
        "filter": [
          "octopus.exe",
          "octopus"
        ]
      }
    ],
    "win": {
      "icon": "desktop/assets/icon.ico",
      "artifactName": "${productName}-${version}-windows-${arch}-setup.${ext}",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "guid": "a4a87c40-2d93-5d84-a543-303b5310a700",
      "include": "installer-native/nsis/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Octopus"
    },
    "mac": {
      "identity": "-",
      "sign": "scripts/desktop-mac-sign.js",
      "hardenedRuntime": false,
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "icon": "desktop/assets/icon.png",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}",
      "target": [
        "AppImage"
      ]
    }
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  }
}
